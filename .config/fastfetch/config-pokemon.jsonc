{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arch.txt",
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": " ❯ "
  },
  "modules": [
    "break",
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "󰔛 ",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "───────────────────────────"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
